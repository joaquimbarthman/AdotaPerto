{
  "name": "adotaperto",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "db:setup": "npm run startup --prefix backend",
    "db:seed": "npm run db:seed --prefix backend",
    "local:up": "docker compose --env-file backend/.env -f backend/infra/docker-compose.yml up -d --wait --wait-timeout 60",
    "local:down": "docker compose --env-file backend/.env -f backend/infra/docker-compose.yml down"
  }
}
