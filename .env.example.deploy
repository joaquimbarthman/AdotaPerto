# Render > New Web Service > Environment: configure estas variáveis no serviço Docker.
# Copie o host de Connect > Session pooler; o índice do host varia por projeto.
DATABASE_URL=postgresql://postgres.<project-ref>:<senha>@<pooler-host>:5432/postgres?sslmode=require

# Supabase > Project Settings > API Keys. Use a chave secret (sb_secret_...).
# A chave legacy service_role também é aceita em SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=<sb_secret_do_projeto>
SUPABASE_STORAGE_BUCKET=adotaperto-images

# Gere um segredo aleatório de pelo menos 32 caracteres.
BETTER_AUTH_SECRET=<segredo-aleatorio>

# Endpoints usados pela API para CEP, lugares e imagens.
VIACEP_BASE_URL=https://viacep.com.br/ws
NOMINATIM_SEARCH_URL=https://nominatim.openstreetmap.org/search
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
WIKIMEDIA_FILE_URL=https://commons.wikimedia.org/wiki/Special:Redirect/file
GOOGLE_MAPS_SEARCH_URL=https://www.google.com/maps/search

# O site e a API usam o mesmo domínio. O Render fornece RENDER_EXTERNAL_URL.
# Para domínio próprio, defina BETTER_AUTH_URL=https://seu-dominio.com
# e inclua esse host em frontend/next.config.ts para imagens enviadas.
# Os estilos abaixo são lidos no build. O Dockerfile usa estes valores padrão;
# defini-los no painel do Render após o build não altera o frontend.
# NEXT_PUBLIC_MAP_STYLE_LIGHT_URL=https://tiles.openfreemap.org/styles/positron
# NEXT_PUBLIC_MAP_STYLE_DARK_URL=https://tiles.openfreemap.org/styles/dark

# Opcional para envio de e-mails:
# RESEND_API_KEY=<chave-resend>
# AUTH_EMAIL_FROM="AdotaPerto <contato@seu-dominio.com>"
