# Configure no servico adotaperto-api do Render.
# DATABASE_URL: connection string Session pooler do Supabase com sslmode=require.
DATABASE_URL=postgresql://postgres.<project-ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase > Project Settings > API (ou Data API).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<chave-secreta-do-servidor>
SUPABASE_STORAGE_BUCKET=adotaperto-images

# Endpoints de geocodificacao e lugares usados pela API.
VIACEP_BASE_URL=https://viacep.com.br/ws
NOMINATIM_SEARCH_URL=https://nominatim.openstreetmap.org/search
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
WIKIMEDIA_FILE_URL=https://commons.wikimedia.org/wiki/Special:Redirect/file

# URLs publicas dos servicos (troque pelos enderecos mostrados no Render).
# Site: https://adotaperto-web.onrender.com
# API:  https://adotaperto-api.onrender.com
# Informe a URL do site aqui; o Blueprint usa a URL da API automaticamente
# em BETTER_AUTH_URL (API) e NEXT_PUBLIC_API_URL (frontend).
FRONTEND_URL=https://adotaperto-web.onrender.com

# Configure no servico adotaperto-web do Render; sao URLs publicas dos estilos do mapa.
# NEXT_PUBLIC_API_URL e injetada pelo Blueprint.
NEXT_PUBLIC_MAP_STYLE_LIGHT_URL=https://tiles.openfreemap.org/styles/positron
NEXT_PUBLIC_MAP_STYLE_DARK_URL=https://tiles.openfreemap.org/styles/dark

# BETTER_AUTH_SECRET e gerada pelo render.yaml.
# Opcional: adicione RESEND_API_KEY no servico da API para habilitar e-mails.
AUTH_EMAIL_FROM="AdotaPerto <contato@seudominio.com>"
